# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='change-me'

# True for local development only.
DEBUG=True

# Comma-separated host names the site is served from.
ALLOWED_HOSTS=127.0.0.1,localhost

# The college's time zone (decides what "today" means for attendance).
TIME_ZONE=Australia/Sydney

# Production only: set to False if testing a DEBUG=False build over plain http.
# SECURE_COOKIES=True
# SECURE_SSL_REDIRECT=False
